# Blind Assistive System - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# OpenWeatherMap API Key (Required for weather service)
# Get your FREE API key at: https://openweathermap.org/api
# Sign up, verify email, and copy your API key here
OPENWEATHER_API_KEY=your_api_key_here

# Optional: Navigation Settings
# NAVIGATION_GPS_UPDATE_INTERVAL=1.0
# NAVIGATION_ARRIVAL_DISTANCE=5.0
# NAVIGATION_REROUTE_THRESHOLD=15.0

# Optional: Voice Settings
# NAVIGATION_VOICE_ENABLED=true
# NAVIGATION_VOICE_VOLUME=1.0
# NAVIGATION_VOICE_RATE=150

# Optional: Obstacle Detection
# NAVIGATION_OBSTACLE_ENABLED=true
# NAVIGATION_OBSTACLE_CONFIDENCE=0.5

# Optional: API URLs
# NAVIGATION_OSRM_URL=https://router.project-osrm.org

# Optional: Logging
# NAVIGATION_LOG_LEVEL=INFO
